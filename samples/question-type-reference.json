                { "number": 23, "answers": ["B"] },
                { "number": 24, "answers": ["C"] }
              ]
            },
            {
              "type": "gap_fill",
              "instructions": "Complete the table below. Write <strong>ONE WORD ONLY</strong> from the passage for each answer.",
