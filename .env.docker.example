# ═══════════════════════════════════════════════════════════
#  Docker 部署設定
#  cp .env.docker.example .env  →  改下面幾項  →  docker compose up -d
# ═══════════════════════════════════════════════════════════

# ── 一定要改的三項 ─────────────────────────────────────────
# 資料庫密碼（隨便一組夠長的字串）
DB_ROOT_PASSWORD=change-this-root-password
DB_PASSWORD=change-this-db-password

# 登入 token 的簽章金鑰，請用一長串隨機字元
# 產生方式： openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── 建議也改 ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=系統管理員

# ── 其他 ───────────────────────────────────────────────────
# 對外開放的埠（前面若有 Nginx，通常設 127.0.0.1:3000 更安全，改成 APP_PORT=127.0.0.1:3000）
APP_PORT=3000
DB_NAME=ielts_cbt
DB_USER=ielts
TOKEN_TTL=12h
TZ=Asia/Taipei

# 在 Nginx / Caddy 反向代理後面時設 1，讓系統讀得到真實來源 IP
TRUST_PROXY=1

# 第一次啟動要不要自動匯入範例試卷與示範帳號（student1~5 / teacher1）
# 上線正式使用建議設 0
SEED_DEMO=1

# ── AI（可留空，之後在網頁「系統設定」填）──────────────────
# AI 端點單次請求的逾時（毫秒）。整份試卷是分成 9 段產生的，
# 每一段都在這個時間內要回完。慢的自架模型可以調大一點。
AI_TIMEOUT_MS=180000

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# 口說即時語音對話用的模型（需 OpenAI 相容的 /realtime 端點）
REALTIME_MODEL=gpt-4o-realtime-preview

# ── Cloudflare Turnstile 登入人機驗證（選用）─────────────
# 到 https://dash.cloudflare.com → Turnstile 免費申請，Widget 的網域要填你的考試網址
# 留空也沒關係，之後可以在網頁「系統設定 → 登入人機驗證」填
TURNSTILE_ENABLED=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 連線池排隊上限（0 = 無上限，不建議）
DB_QUEUE_LIMIT=60
