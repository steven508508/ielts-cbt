# ── 伺服器 ─────────────────────────────────────────────
PORT=3000
# 用來簽發登入 token，正式上線請改成一串隨機字元
JWT_SECRET=change-me-to-a-long-random-string
# 登入有效時間
TOKEN_TTL=12h

# ── MySQL 資料庫 ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ielts
DB_PASSWORD=ielts_pass
DB_NAME=ielts_cbt

# ── 首位管理員（第一次啟動時自動建立）─────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_NAME=系統管理員

# ── AI 設定（也可以之後在網頁「系統設定」裡填，不必寫在這裡）──
# 供應商：anthropic | openai | custom
AI_PROVIDER=anthropic

# Claude（Anthropic）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI（或任何 OpenAI 相容服務：Azure、DeepSeek、Groq、Ollama、one-api…）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 自訂端點（protocol 填 anthropic 或 openai，代表對方用哪種 API 格式）
CUSTOM_PROTOCOL=openai
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# 語音：轉文字 / 文字轉語音（可與上面主供應商不同家）
STT_PROVIDER=openai
STT_MODEL=whisper-1
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# 口說「即時語音對話」用的 Realtime 模型
# 需要 OpenAI 相容的 /realtime WebSocket 端點；沒設定會自動退回「念題→錄音」的問答模式
REALTIME_MODEL=gpt-4o-realtime-preview

# ── Cloudflare Turnstile 登入人機驗證（選用）─────────────
# 到 https://dash.cloudflare.com → Turnstile 免費申請一組
# 也可以留空，之後在網頁「系統設定」填
TURNSTILE_ENABLED=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
